# انسخ الملف ده لـ .env وحط قيمك الحقيقية فيه.
# .env نفسه في .gitignore وعمره ما يروح GitHub.

# --- Supabase ---
supabase_url=https://xxxxxxxxxxxx.supabase.co
# المفتاح السري (service_role). بيتخطى RLS. السيرفر بس.
supabase_service_key=

# --- Gemini ---
gemini_api_key=
gemini_model=gemini-3.6-flash
gemini_fallback_model=gemini-3.5-flash-lite

# --- الأدمن ---
# إيميلات مفصولة بفاصلة. لازم تتملى قبل النشر.
admin_emails=

# --- الزحف ---
crawl_delay_seconds=30
crawl_max_categories=0
