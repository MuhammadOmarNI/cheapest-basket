# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# ---------------------------------------------------------------------------
# Supabase (browser-safe: the anon key is designed to be public, but see the
# Row Level Security note in README.md before putting real data in it)
# Find these at: Supabase dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Your AI key — SERVER SIDE ONLY.
# No VITE_ prefix on purpose: anything starting with VITE_ gets bundled into
# the browser where anyone can read it. This one is only ever read inside
# api/estimate-price.js, which runs on Vercel's server.
# ---------------------------------------------------------------------------
AI_API_KEY=your-ai-api-key
